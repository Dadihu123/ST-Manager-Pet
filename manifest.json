{
  "id": "stm-pet",
  "name": "桌面宠物",
  "version": "0.4.0",
  "api_version": 3,
  "manifest_version": 3,
  "author": "ST-Manager",
  "description": "常驻桌面的宠物：跟随宿主状态活动、可拖动、会下坠与行走、长时间没互动会睡着；支持自己新建形象（可署名作者、指定标准图像、调触发节奏）、导入形象包、按形象调整大小与渲染方式，并在设置页直接预览每个动作的动画效果；不想看到它时可以一键关闭，不必卸载插件。",
  "license": "MIT",
  "min_app_version": "1.0.0",
  "backend": {
    "entry": "backend",
    "register": "register",
    "jobs": [],
    "hooks": []
  },
  "frontend": {
    "entry": "frontend/plugin.js",
    "styles": [
      "frontend/plugin.css"
    ],
    "render_mode": "custom",
    "contributions": {
      "menus": [
        {
          "id": "pet-dock",
          "placement": "dock",
          "type": "item",
          "label": "桌面宠物",
          "description": "打开桌面宠物设置：显示开关、形象管理、作者署名、标准图像、触发时间、播报与勿扰。",
          "icon": "frontend/assets/icon.svg",
          "order": 45,
          "action": {
            "type": "surface",
            "id": "pet-settings"
          }
        },
        {
          "id": "pet-settings",
          "placement": "settings.nav",
          "type": "item",
          "label": "桌面宠物设置",
          "description": "显示开关、形象管理与导入、作者署名、标准图像、触发时间、播报与勿扰。",
          "icon": "frontend/assets/icon.svg",
          "order": 80,
          "action": {
            "type": "surface",
            "id": "pet-settings"
          }
        }
      ],
      "slots": [],
      "commands": []
    }
  },
  "capabilities": [
    "ui.custom"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "quiet_mode": {
        "type": "boolean",
        "title": "勿扰模式",
        "description": "开启后宠物只换动作、不弹提示，且全屏遮罩期间不打扰。",
        "default": false
      },
      "announce_cards": {
        "type": "boolean",
        "title": "卡片更新时播报",
        "description": "宿主里卡片被创建 / 更新 / 移动时让宠物做出反应（已限流）。",
        "default": true
      },
      "announce_jobs": {
        "type": "boolean",
        "title": "扫描 / 索引完成时播报",
        "description": "全量扫描或索引作业结束时让宠物做出反应。",
        "default": true
      },
      "show_toast": {
        "type": "boolean",
        "title": "播报时弹轻提示",
        "description": "关闭后宠物只换动作，不弹宿主轻提示。",
        "default": false
      }
    }
  }
}
