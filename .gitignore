# 运行时用户数据：宿主保证插件更新时保留该目录，因此不进版本库
data/

# 构建 / 核对产物（截图、报告）
artifacts/

# 临时脚本 / 一次性诊断产物
tmp/

# 提示词 / 方案书
# 用 docs/*（而不是 docs/）：排除目录本身会让 git 根本不进这个目录，
# 下面那条 ! 例外就永远没机会生效
docs/*
# 例外：agent 技能配置随仓库走（issue tracker / 标签词汇 / 域文档布局），
# 团队与换机器后都要用；docs/ 下其余内容仍被忽略
!docs/agents/

# 图像生成工作台的产物（本地临时图，不属于插件资源）
dsh-image-gen/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 编辑器 / 系统
.idea/
.vscode/
*.log
Thumbs.db
desktop.ini
